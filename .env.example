# Runtime profile. Use `staging` for the test environment and `production`
# for the live environment.
NEXT_PUBLIC_APP_ENV=development

# Keep mocks enabled until the API service is available. Set this to false
# after the frontend is connected to the real backend.
NEXT_PUBLIC_ENABLE_MOCKS=true

# Browser requests use the public API URL. In production this should be the
# public Railway domain of the API service, for example https://api.example.com.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-to-server URL for future server actions and route handlers. This is
# private and must not use the NEXT_PUBLIC_ prefix when it contains an internal
# Railway hostname.
API_INTERNAL_URL=http://localhost:8000

# Local Compose services. These defaults are safe development-only values.
APP_ENV=development
POSTGRES_DB=groupproof
POSTGRES_USER=groupproof
POSTGRES_PASSWORD=groupproof-local
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# Optional separate admin application URL for cross-app links.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Optional integration settings. Compose supplies local DATABASE_URL/REDIS_URL
# to the API and worker; never commit real credentials here.
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
AI_PROVIDER=
AI_API_KEY=
