# GroupProof 部署配置占位（真实值只放在部署环境，禁止写入代码、文档或提交记录）
# 复制为 .env 后填写；APP_MODE=real 时缺任何必备项都会启动失败，不退回演示/Mock 模式。

# --- 应用 ---
# real=生产（强制真实 OAuth/SMTP/HTTPS）；dev=本地开发；mock=隔离演示（仅本地）
APP_MODE=dev
# 浏览器访问的站点源（CSRF Origin 校验；real 必须 https://）
APP_ORIGIN=http://localhost:3000
# Next.js 服务端访问 FastAPI 的内部地址（同源代理 /api/v1/* 的转发目标）
API_INTERNAL_URL=http://localhost:8000
# 隔离演示模式的前端开关（生产不设置；演示角色选择器仅在 mock 下出现）
# NEXT_PUBLIC_APP_MODE=mock

# --- PostgreSQL ---
# 用户账户与注册审核模块（users/auth_identities/school_email_bindings/academic_identity_checks/
# sessions/email_challenges/teacher_applications/auth_audit_events/oauth_transactions 等）
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/groupproof
# 迁移：cd server && alembic upgrade head（连接串同 DATABASE_URL）
# 业务数据存储接入前见 server/docs/DB_FIELD_DICTIONARY.md 的“业务数据边界”

# --- 提供方开关（可选提供方缺失只关闭对应入口，不影响其他通道）---
# real 模式下“启用但未配置”会拒绝启动（发布检查）；未开放请显式关闭
AUTH_GOOGLE_ENABLED=true
AUTH_PASSWORD_ENABLED=true
AUTH_EMAIL_SIGNUP_ENABLED=true
AUTH_PASSWORD_RESET_ENABLED=true

# --- Google OIDC（真实凭据在 Google Cloud 控制台创建，回调地址显式登记）---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# 生产保持 Google 默认值；仅隔离测试可指向测试 OIDC 提供方
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_EXPECTED_ISSUER=https://accounts.google.com

# --- 学校邮件（验证码）---
# smtp=真实投递（real 必须）；capture=隔离开发/测试邮件捕获器（生产禁止）
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# TLS 只由 SMTP_TLS_MODE 决定（无独立 STARTTLS 开关）：starttls(587) / implicit(465, SSL) / none（仅隔离环境）
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM=noreply@example.edu.mo
# capture 模式的本地捕获目录（仅非 real）
CAPTURE_DIR=.mail-capture

# --- 验证码 HMAC 密钥（生成：openssl rand -hex 32）---
EMAIL_CHALLENGE_HMAC_KEY=

# --- 学校规则（上线前由学校确认；未确认项保持现状不臆造）---
STUDENT_EMAIL_DOMAIN=student.must.edu.mo
TEACHER_EMAIL_DOMAIN=must.edu.mo
# 学号格式（默认仅禁止空白、4–20 位；不得臆造“固定 6 位”）
STUDENT_ID_PATTERN=^\S{4,20}$
# 学号与邮箱本地部分对应关系：none=未确认不强制；match_prefix=确认后启用
STUDENT_ID_EMAIL_RULE=none

# --- 会话期限（产品参数，秒）---
SESSION_ONBOARDING_IDLE=1800
SESSION_ONBOARDING_ABSOLUTE=43200
SESSION_FULL_IDLE=7200
SESSION_FULL_ABSOLUTE=604800
SESSION_ADMIN_IDLE=1800
SESSION_ADMIN_ABSOLUTE=43200

# --- 业务数据来源（P2 未完成项）---
# dev/test 可指向隔离演示数据集；APP_MODE=real 且未接入真实业务库时业务接口返回 SERVICE_UNAVAILABLE
# BUSINESS_DATA_FILE=server/tests/data/workspace.json

# --- 注册/恢复事务（产品参数，秒）---
# PRE_REGISTRATION_TTL_SECONDS=600
# PASSWORD_RESET_TTL_SECONDS=1200

# --- 初始管理员（受控初始化，服务端执行；不提供公开注册入口）---
# cd server && ./.venv/bin/python -m scripts.bootstrap_admin --google-sub <sub> --name ... --username ... --school-email ...

# --- 验收用临时密令（仅 dev/测试；APP_MODE=real 配置会启动失败，发布检查强制）---
# 注册弹窗“登录邮箱”框输入密令 = 直达信息完善页（全新测试账户+真实会话）；
# 验证码框输入同一密令 = 直通学校邮箱/登录邮箱验证（无需发码）。验收结束后删除此配置。
# ACCEPTANCE_TEST_TOKEN=202610
